{
  "name": "daftar",
  "version": "0.1.0",
  "private": true,
  "description": "DAFTAR — multi-tenant SaaS commerce platform",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/admin",
    "packages/domain-core",
    "packages/accounting",
    "packages/shared-contracts",
    "packages/design-system"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test -w @daftar/domain-core && npm run test -w @daftar/accounting && npm run test -w @daftar/shared-contracts",
    "test:integration": "vitest run tests/integration tests/security",
    "test:golden": "vitest run tests/golden-regression",
    "perf:baseline": "vitest run tests/perf",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w @daftar/api",
    "bootstrap:db-roles": "tsx scripts/bootstrap-db-roles.ts",
    "check:localization": "tsx scripts/check-localization.ts",
    "check:guards": "tsx scripts/static-guards.ts",
    "check:migrations": "tsx scripts/check-migration-manifest.ts",
    "check:supply-chain": "tsx scripts/check-supply-chain.ts",
    "evidence:phase2:s8": "tsx scripts/phase2-s8-evidence.ts",
    "check:db-from-zero": "tsx scripts/db-from-zero.ts",
    "bootstrap:platform-owner": "tsx scripts/bootstrap-platform-owner.ts",
    "bootstrap:provisioning-key": "tsx scripts/install-provisioning-key.ts",
    "bootstrap:accounting-key": "tsx scripts/install-accounting-key.ts",
    "check:key-retirement": "tsx scripts/check-key-retirement.ts",
    "gate:phase1": "tsx scripts/phase1-gate.ts",
    "gate:phase1:release": "tsx scripts/phase1-release-gate.ts",
    "gate:phase1:dev": "tsx scripts/phase1-release-gate.ts --dev",
    "gate:phase2:s1": "tsx scripts/phase2-s1-gate.ts",
    "gate:phase2:s2": "tsx scripts/phase2-s2-gate.ts",
    "gate:phase2:s3": "tsx scripts/phase2-s3-gate.ts",
    "gate:phase2:s4": "tsx scripts/phase2-s4-gate.ts",
    "gate:phase2:s5": "tsx scripts/phase2-s5-gate.ts",
    "gate:phase2:s6": "tsx scripts/phase2-s6-gate.ts",
    "gate:phase2:s7": "tsx scripts/phase2-s7-gate.ts",
    "gate:phase2:s8": "tsx scripts/phase2-s8-gate.ts",
    "export:release": "tsx scripts/export-release.ts",
    "verify:history": "tsx scripts/verify-migration-history.ts",
    "rehearse:phase2:rollback": "tsx scripts/phase2-rollback-rehearsal.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/testing": "11.2.5",
    "@types/node": "24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.1",
    "prettier": "3.7.1",
    "supertest": "^7.1.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@smithy/node-http-handler": "^4.12.1",
    "nodemailer": "^10.0.10"
  },
  "overrides": {
    "multer": "2.4.0",
    "postcss": "8.5.28"
  }
}
