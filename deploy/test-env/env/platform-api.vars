# TEST ENVIRONMENT ONLY (DR-173/5). Every secret is a named PLACEHOLDER; no real secret, no merchant data, no domain.
# Guard: tests-unit/deploy-test-env-guard.test.ts
NODE_ENV=development
REDIS_URL=redis://redis:6379
PROCESS_MODE=platform-api
PORT=3001
JWT_SECRET=PLACEHOLDER-jwt-session-signing-secret-not-real
TRUSTED_PROXIES=172.16.0.0/12
PLATFORM_DATABASE_URL=postgresql://daftar_platform:PLACEHOLDER-platform@postgres:5432/daftar
IDENTITY_DATABASE_URL=postgresql://daftar_identity:PLACEHOLDER-identity@postgres:5432/daftar
