{
  "name": "@daftar/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prebuild": "npm run build -w @daftar/domain-core && npm run build -w @daftar/shared-contracts",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @daftar/domain-core && npm run build -w @daftar/shared-contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/infra/migrate.ts"
  },
  "dependencies": {
    "@daftar/accounting": "*",
    "@daftar/domain-core": "*",
    "@daftar/inventory": "*",
    "@daftar/shared-contracts": "*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/throttler": "6.4.0",
    "argon2": "0.45.1",
    "image-size": "2.0.4",
    "ioredis": "5.9.2",
    "jose": "6.1.3",
    "pg": "8.16.3",
    "pino": "10.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/pg": "8.15.6"
  }
}
