<?xml version="1.0" encoding="utf-8"?>
<!--
  TLS-only in every build. Cleartext is denied globally; the debug build
  additionally trusts user-installed CAs for local development proxies.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
